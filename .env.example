# Copy this file to .env and fill in your own values.
# Never commit .env — it's already in .gitignore.

# Postgres connection string (Vercel Postgres, Supabase, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — used for email/password account creation and sessions.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key — powers the on-demand / auto community-signal reports.
# Use a dedicated key on its own Workspace with a spend cap, not your main console key.
ANTHROPIC_API_KEY="sk-ant-your-own-key"

# Telegram bot token — used to notify a user when their requested analysis is ready.
# Create one via @BotFather; each user links their own chat ID from inside the app.
TELEGRAM_BOT_TOKEN="your-own-bot-token"

# Telegram bot's @username (no @), from the same BotFather conversation —
# used to build the "tap to connect" deep link in Settings.
TELEGRAM_BOT_USERNAME="your_bot_username"

# Random secret Telegram includes on every webhook call, so our webhook
# route can tell a real Telegram request apart from anyone else POSTing to
# that URL. Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET="replace-with-a-generated-secret"

# Cron secret — protects the /api/cron endpoint Vercel Cron calls on a schedule.
CRON_SECRET="replace-with-a-generated-secret"

# --- SoCLaaS (NUS School of Computing's free LLM gateway) — optional ---
# Set LLM_PROVIDER=soclaas to use this instead of Anthropic for module
# research (free/unlimited for NUS SoC students, but no live web search —
# see src/lib/soclaas.ts for the trade-off). Leave LLM_PROVIDER unset or
# "anthropic" to keep the default, live-search behavior.
# Get your key from https://soclaas-portal.comp.nus.edu.sg/ (NUS network only).
LLM_PROVIDER="anthropic"
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
SOCLAAS_API_KEY="clsk_your-own-key"
SOCLAAS_MODEL="default"
