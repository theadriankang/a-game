// Multi-user schema: anyone can create their own account and build their own
// module plan. Nothing here is specific to one person — degree programme,
// exemptions, and residential-college requirements are all stored per user,
// not hardcoded.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- auth (NextAuth Prisma adapter shape) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())

  // Degree context, set during onboarding — not assumed for every user.
  programme       String?  // e.g. "BComp (Computer Science)"
  priorDiploma    String?  // e.g. "SP Engineering with Business", nullable
  suBudgetTotalMc Int      @default(32)
  suBudgetUsedMc  Int      @default(0) // unused: S/U used is derived from PlannerEntry.isSU (docs/su-budget.md)

  // Start year of the academic year the user matriculated in (2023 for
  // AY2023/24). Drives which year's exemption rules apply to them, since
  // each faculty republishes its APC lists per intake. Null for accounts
  // created before this was collected.
  matriculationYear Int?

  // How the student meets NUS's "good H2 pass in Mathematics (or equivalent)" condition: H2 | IB_HL | POLY_CERT |
  // PASSED_TEST | NONE (see src/lib/qualifications.ts). Null = never asked, treated as not covered.
  mathBackground String?

  // Which LLM backend this user's own on-demand module-analysis requests
  // use (the "Request analysis" button - see Settings page). Doesn't
  // affect already-cached reports (ModuleAnalysis is a shared cache, see
  // below) or AUTO_* requests, which always use the deployment-wide
  // default instead, since nobody specific is waiting on those.
  preferredLlmProvider LlmProvider @default(ANTHROPIC)

  // Platform admin flag — gates /admin (the analytics dashboard). Not
  // self-serve: flipped manually (Prisma Studio or a one-off SQL update) by
  // Adrian for himself and whichever other administrators he trusts, never
  // settable from any in-app UI. Unrelated to NextAuth's own auth — this is
  // an authorization bit on top of an already-authenticated session.
  isAdmin Boolean @default(false)

  // Short-lived token for the Telegram account-linking deep link - cleared
  // once used or expired. Not a session/auth credential, just a one-time
  // "which app account does this /start come from" lookup.
  telegramLinkToken          String?   @unique
  telegramLinkTokenExpiresAt DateTime?

  // Forgot-password flow. Unlike telegramLinkToken above, this stores a
  // SHA-256 hash of the token, never the raw value - a leaked DB row alone
  // then can't be used to reset the account, since the raw token only ever
  // lives in the emailed link. Cleared on successful reset or overwritten
  // by a newer request (only the latest requested link stays valid).
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?

  accounts        Account[]
  sessions        Session[]
  plannerEntries  PlannerEntry[]
  analysisRequest AnalysisRequest[]
  telegramLink    TelegramLink?
  savedTimetables SavedTimetable[]
  dailyActive     DailyActive[]
  featureUsage    FeatureUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- planning ---

enum PlanStatus {
  COMPLETED
  PLANNED
  RESERVED // held for a college / programme requirement, not yet a real module
}

model PlannerEntry {
  id           String     @id @default(cuid())
  userId       String
  moduleCode   String?    // null while the slot is a placeholder (e.g. "Reserved")
  label        String     // display title; module title, or a reserved-slot name
  mc           Int
  academicYear Int        // 1, 2, 3, 4...
  semester     Int        // 1 or 2
  status       PlanStatus
  requirementTag String?  // which degree-requirement bucket this counts toward
  isSU         Boolean    @default(false) // uses the S/U option; only ever set on modules NUS allows S/U on (src/lib/su-budget.ts)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("planner_entries")
}

// --- community signal (shared cache across all users, not per-user data) ---

enum LlmProvider {
  ANTHROPIC
  SOCLAAS
}

enum AnalysisTrigger {
  AUTO_COMPULSORY
  AUTO_PLANNED
  ON_DEMAND
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  THIN_DATA
}

model ModuleAnalysis {
  id          String         @id @default(cuid())
  moduleCode  String
  academicYear String        // which AY's offering this report covers
  summary     String         @db.Text
  tags        String[]       // e.g. ["Heavy workload", "Team project"]
  // Parallel array, index-matched to tags: how often each tag's sentiment
  // echoed across the sources Claude found (1 = one source, 5 = most
  // sources) - drives the bubble/word-cloud sizing in the UI. Empty for
  // reports generated before this field existed; the UI falls back to
  // equal-sized bubbles when it's missing or short.
  tagWeights  Int[]
  // A separate, larger set of short (1-3 word) keywords/sentiment terms
  // for the word-cloud visual - distinct from `tags` (which stays a
  // small curated set for the pill row). Same index-matched-weight
  // scheme as tags/tagWeights. Empty for reports made before this field
  // existed.
  keywords       String[]
  keywordWeights Int[]
  sources     String[]       // URLs or source descriptions, for transparency
  status      AnalysisStatus @default(PENDING)
  tokensUsed  Int?
  costUsd     Float?
  // Which LLM actually produced this report - shown in the UI so users
  // know whether a given summary had live web search (Anthropic) or not
  // (SoCLaaS - see src/lib/soclaas.ts). Rows from before this field
  // existed default to Anthropic, the only provider that existed then.
  provider    LlmProvider    @default(ANTHROPIC)
  createdAt   DateTime       @default(now())

  @@unique([moduleCode, academicYear])
  @@map("module_analyses")
}

// One row per user-triggered (or auto) request, so the usage page can show
// "what this platform has consumed" without touching anyone's personal
// Anthropic account or billing details.
model AnalysisRequest {
  id         String          @id @default(cuid())
  userId     String?         // null for scheduled/auto runs not tied to a click
  moduleCode String          // logged by code only; not tied to a specific ModuleAnalysis row
  trigger    AnalysisTrigger
  status     AnalysisStatus  @default(PENDING)
  tokensUsed Int?
  costUsd    Float?
  // The provider that actually served this request - see the same field
  // on ModuleAnalysis for why. Set even on a cache-hit request (one that
  // didn't call an LLM itself), recording which provider produced the
  // cached result it got back.
  provider   LlmProvider     @default(ANTHROPIC)
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("analysis_requests")
}

model TelegramLink {
  userId String @id
  chatId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

// One saved NUSMods share link per user per Year/Semester slot, matching
// the same academicYear/semester numbering PlannerEntry uses. Lets the
// Timetable page remember a link across visits instead of re-pasting it
// every time - saving is opt-in, not automatic (see app/timetable).
model SavedTimetable {
  id           String   @id @default(cuid())
  userId       String
  academicYear Int      // 1, 2, 3, 4...
  semester     Int      // 1 or 2
  shareUrl     String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, academicYear, semester])
  @@map("saved_timetables")
}

// --- admin analytics (platform-usage signal, not personal/content data) ---

// One row per user per calendar day they were meaningfully active (any
// tracked feature touched that day). Upserted rather than inserted per
// request, so DAU/MAU/stickiness and "last active" are a plain
// count/groupBy over a table sized users × days — not users × requests —
// and need no cron rollup job to stay queryable (the project's cron is
// already pinned to Vercel Hobby's once-daily limit elsewhere; this
// avoids adding a second dependency on it).
model DailyActive {
  userId String
  date   DateTime @db.Date // truncated to the day, UTC — see src/lib/track.ts

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
  @@map("daily_active")
}

// One row per user per feature per day, counting how many times that
// feature was touched. Same upsert-and-increment shape as DailyActive,
// for the same reason. `feature` is a free-text slug (not an enum) so a
// new tracked feature never needs a migration — see FEATURES in
// src/lib/track.ts for the canonical list in use.
model FeatureUsage {
  userId  String
  feature String
  date    DateTime @db.Date
  count   Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature, date])
  @@index([feature, date])
  @@map("feature_usage")
}

// --- exemptions / advanced placement credits (shared reference data) ---
//
// Loaded offline by scripts/exemptions (never scraped at request time) from
// each faculty's published APC lists, one row per module granted. The app
// only reads these to pre-fill onboarding suggestions - see
// src/lib/exemptions and docs/exemptions-pipeline.md.

enum ExemptionQualification {
  POLYTECHNIC
  H3
  OLYMPIAD
}

// One row per diploma / medal category per intake year per programme group;
// `grants` is the list of credits it earns:
//   { moduleCode: string|null, label, mc, kind: "PROGRAMME"|"UNRESTRICTED_ELECTIVE",
//     grant: "AUTOMATIC"|"OPT_IN", note: string|null }
// moduleCode is null for generic credit with no module code (e.g. "20 units of UEs").
model ExemptionRule {
  id            String                 @id @default(cuid())
  academicYear  String                 // intake AY the rule was published for, e.g. "2026-27"
  faculty       String                 // matches nus-programmes.ts faculty names
  programmes    String[]               // app programme names it applies to; empty = every programme in the faculty
  qualification ExemptionQualification
  institution   String?                // e.g. "Nanyang Polytechnic"; null when not institution-specific
  credential    String                 // diploma / medal category as published; "*" = any holder
  credentialKey String                 // normalised credential, for matching ("*" = any)
  grants        Json
  sourceUrl     String
  snapshotAt    DateTime?              // capture time of the page/PDF the rule came from

  @@index([academicYear, qualification, credentialKey])
  @@map("exemption_rules")
}

// --- module catalog (shared reference data) ---
//
// Every module code NUSMods has listed in the last few academic years, so
// autocomplete and validation don't depend on a live NUSMods call and can
// recognise modules that have since been retired or renamed (exemptions often
// name those). Filled by scripts/modules/sync.ts.
model CatalogModule {
  code          String   @id // "CS1010A"
  title         String       // as of the newest AY that lists it
  mc            Float?       // null when only known from the condensed list
  academicYears String[]     // NUSMods AYs that list it, e.g. ["2025-2026", "2026-2027"]
  lastListedAy  String?      // newest of academicYears; null for codes only known from exemption lists. Ranks current modules first.
  updatedAt     DateTime @updatedAt

  @@map("catalog_modules")
}
